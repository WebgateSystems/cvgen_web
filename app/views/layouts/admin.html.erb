<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-controller="theme"
      data-label-system="<%= t('nav.theme_system') %>"
      data-label-light="<%= t('nav.theme_light') %>"
      data-label-dark="<%= t('nav.theme_dark') %>">
  <head>
    <title><%= content_for?(:title) ? yield(:title) : t("admin.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script>
      (function () {
        var pref = localStorage.getItem("cvgen-theme") || "system";
        var dark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        var theme = pref === "light" || pref === "dark" ? pref : (dark ? "dark" : "light");
        document.documentElement.setAttribute("data-bs-theme", theme);
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=Sora:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag "application", "cvgen", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="admin-body">
    <div class="admin-shell">
      <aside class="admin-sidebar">
        <a class="brand brand--admin" href="<%= admin_root_path %>"><%= t("brand") %></a>
        <p class="admin-sidebar__label"><%= t("admin.sidebar") %></p>
        <nav class="admin-nav">
          <%= link_to admin_root_path, class: "admin-nav__link #{'is-active' if controller_name == 'dashboard'}" do %>
            <i class="bi bi-grid" aria-hidden="true"></i>
            <%= t("admin.dashboard") %>
          <% end %>
          <%= link_to admin_users_path, class: "admin-nav__link #{'is-active' if controller_name == 'users'}" do %>
            <i class="bi bi-people" aria-hidden="true"></i>
            <%= t("admin.users.title") %>
          <% end %>
          <%= link_to admin_themes_path, class: "admin-nav__link #{'is-active' if controller_name == 'themes'}" do %>
            <i class="bi bi-palette" aria-hidden="true"></i>
            <%= t("admin.themes.title") %>
          <% end %>
        </nav>
        <div class="admin-sidebar__foot">
          <%= link_to t("nav.studio"), jobseeker_root_path, class: "admin-nav__link" %>
          <%= link_to t("admin.back_to_site"), root_path, class: "admin-nav__link" %>
          <%= button_to t("nav.sign_out"), destroy_user_session_path, method: :delete, class: "admin-nav__link admin-nav__link--btn" %>
        </div>
      </aside>

      <div class="admin-main">
        <header class="admin-topbar">
          <div class="dropdown">
            <button class="ctrl-btn dropdown-toggle" type="button" data-bs-toggle="dropdown">
              <%= I18n.locale.to_s.upcase %>
            </button>
            <ul class="dropdown-menu">
              <li><%= link_to "English", locale_path(locale: :en), class: "dropdown-item" %></li>
              <li><%= link_to "Polski", locale_path(locale: :pl), class: "dropdown-item" %></li>
            </ul>
          </div>
          <div class="dropdown">
            <button class="ctrl-btn dropdown-toggle" type="button" data-bs-toggle="dropdown">
              <i class="bi bi-circle-half"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><button type="button" class="dropdown-item" data-action="theme#system"><%= t("nav.theme_system") %></button></li>
              <li><button type="button" class="dropdown-item" data-action="theme#light"><%= t("nav.theme_light") %></button></li>
              <li><button type="button" class="dropdown-item" data-action="theme#dark"><%= t("nav.theme_dark") %></button></li>
            </ul>
          </div>
          <span class="nav-user"><%= current_user.email %></span>
        </header>

        <% if notice.present? %>
          <div class="alert alert-success mx-4 mt-3" role="status"><%= notice %></div>
        <% end %>
        <% if alert.present? %>
          <div class="alert alert-danger mx-4 mt-3" role="alert"><%= alert %></div>
        <% end %>

        <div class="admin-content">
          <%= yield %>
        </div>
      </div>
    </div>
  </body>
</html>
