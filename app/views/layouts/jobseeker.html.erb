<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-controller="theme"
      data-label-system="<%= t('nav.theme_system') %>"
      data-label-light="<%= t('nav.theme_light') %>"
      data-label-dark="<%= t('nav.theme_dark') %>">
  <head>
    <title><%= content_for?(:title) ? yield(:title) : t("jobseeker.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script>
      (function () {
        var pref = localStorage.getItem("cvgen-theme") || "system";
        var dark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        var theme = pref === "light" || pref === "dark" ? pref : (dark ? "dark" : "light");
        document.documentElement.setAttribute("data-bs-theme", theme);
        document.documentElement.removeAttribute("data-sidebar");
        if (localStorage.getItem("cvgen-sidebar") === "collapsed") {
          document.documentElement.classList.add("sidebar-collapsed");
        }
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=Sora:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag "application", "cvgen", "data-turbo-track": "reload" %>
    <%= render "shared/app_version_styles" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="admin-body">
    <div class="admin-shell">
      <aside class="admin-sidebar" data-controller="sidebar"
             data-label-collapse="<%= t('nav.collapse_sidebar') %>"
             data-label-expand="<%= t('nav.expand_sidebar') %>">
        <div class="admin-sidebar__head">
          <a class="brand brand--admin" href="<%= jobseeker_root_path %>" title="<%= t("brand") %>">
            <span class="brand__full"><%= t("brand") %></span>
            <span class="brand__mark" aria-hidden="true">C</span>
          </a>
          <button type="button" class="admin-sidebar__toggle"
                  data-sidebar-target="toggle" data-action="sidebar#toggle"
                  aria-controls="jobseeker-sidebar-nav"
                  aria-expanded="true" aria-label="<%= t("nav.collapse_sidebar") %>"
                  title="<%= t("nav.collapse_sidebar") %>">
            <i class="bi bi-chevron-double-left" data-sidebar-target="icon" aria-hidden="true"></i>
          </button>
        </div>
        <p class="admin-sidebar__label"><%= t("jobseeker.sidebar") %></p>
        <nav id="jobseeker-sidebar-nav" class="admin-nav">
          <%= link_to jobseeker_root_path, class: "admin-nav__link #{'is-active' if controller_name == 'dashboard'}", title: t("jobseeker.dashboard") do %>
            <i class="bi bi-house" aria-hidden="true"></i>
            <span class="admin-nav__text"><%= t("jobseeker.dashboard") %></span>
          <% end %>
          <%= link_to jobseeker_applications_path, class: "admin-nav__link #{'is-active' if controller_name == 'applications'}", title: t("jobseeker.applications.title") do %>
            <i class="bi bi-bar-chart" aria-hidden="true"></i>
            <span class="admin-nav__text"><%= t("jobseeker.applications.title") %></span>
          <% end %>
          <%= link_to jobseeker_cv_path, class: "admin-nav__link #{'is-active' if controller_name == 'cvs'}", title: t("jobseeker.cvs.title") do %>
            <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i>
            <span class="admin-nav__text"><%= t("jobseeker.cvs.title") %></span>
          <% end %>
          <%= link_to jobseeker_profiles_path, class: "admin-nav__link #{'is-active' if %w[profiles versions].include?(controller_name)}", title: t("jobseeker.profiles.title") do %>
            <i class="bi bi-person-badge" aria-hidden="true"></i>
            <span class="admin-nav__text"><%= t("jobseeker.profiles.title") %></span>
          <% end %>
          <%= link_to jobseeker_themes_path, class: "admin-nav__link #{'is-active' if controller_name == 'themes'}", title: t("jobseeker.themes.title") do %>
            <i class="bi bi-palette" aria-hidden="true"></i>
            <span class="admin-nav__text"><%= t("jobseeker.themes.title") %></span>
          <% end %>
        </nav>
        <div class="admin-sidebar__foot">
          <% if current_user.admin? %>
            <%= link_to admin_root_path, class: "admin-nav__link", title: t("nav.admin") do %>
              <i class="bi bi-shield-lock" aria-hidden="true"></i>
              <span class="admin-nav__text"><%= t("nav.admin") %></span>
            <% end %>
          <% end %>
          <%= link_to root_path, class: "admin-nav__link", title: t("admin.back_to_site") do %>
            <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
            <span class="admin-nav__text"><%= t("admin.back_to_site") %></span>
          <% end %>
          <%= button_to destroy_user_session_path, method: :delete, class: "admin-nav__link admin-nav__link--btn",
                title: t("nav.sign_out"), form: { class: "admin-nav__form" } do %>
            <i class="bi bi-box-arrow-left" aria-hidden="true"></i>
            <span class="admin-nav__text"><%= t("nav.sign_out") %></span>
          <% end %>
        </div>
      </aside>

      <div class="admin-main">
        <header class="admin-topbar">
          <%= render "shared/app_version" %>
          <div class="admin-topbar__tools">
            <div class="dropdown">
              <button class="ctrl-btn dropdown-toggle" type="button" data-bs-toggle="dropdown">
                <%= I18n.locale.to_s.upcase %>
              </button>
              <ul class="dropdown-menu">
                <li><%= link_to "English", locale_path(locale: :en), class: "dropdown-item" %></li>
                <li><%= link_to "Polski", locale_path(locale: :pl), class: "dropdown-item" %></li>
              </ul>
            </div>
            <div class="dropdown">
              <button class="ctrl-btn dropdown-toggle" type="button" data-bs-toggle="dropdown">
                <i class="bi bi-circle-half"></i>
              </button>
              <ul class="dropdown-menu dropdown-menu-end">
                <li><button type="button" class="dropdown-item" data-action="theme#system"><%= t("nav.theme_system") %></button></li>
                <li><button type="button" class="dropdown-item" data-action="theme#light"><%= t("nav.theme_light") %></button></li>
                <li><button type="button" class="dropdown-item" data-action="theme#dark"><%= t("nav.theme_dark") %></button></li>
              </ul>
            </div>
            <span class="nav-user"><%= current_user.email %></span>
          </div>
        </header>

        <% if notice.present? %>
          <div class="alert alert-success mx-4 mt-3" role="status"><%= notice %></div>
        <% end %>
        <% if alert.present? %>
          <div class="alert alert-danger mx-4 mt-3" role="alert"><%= alert %></div>
        <% end %>

        <div class="admin-content">
          <%= yield %>
        </div>
      </div>
    </div>
  </body>
</html>
