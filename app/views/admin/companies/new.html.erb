<% content_for :title, t("admin.companies.new") %>

<h1 class="admin-h1"><%= t("admin.companies.new") %></h1>
<p class="admin-lead"><%= t("admin.companies.lead") %></p>

<ul class="nav nav-tabs mb-4" role="tablist">
  <li class="nav-item" role="presentation">
    <button class="nav-link <%= "active" unless @tab == "url" %>" id="company-manual-tab"
            data-bs-toggle="tab" data-bs-target="#company-manual" type="button" role="tab"
            aria-controls="company-manual" aria-selected="<%= @tab != "url" %>">
      <%= t("admin.companies.tabs.manual") %>
    </button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link <%= "active" if @tab == "url" %>" id="company-url-tab"
            data-bs-toggle="tab" data-bs-target="#company-url" type="button" role="tab"
            aria-controls="company-url" aria-selected="<%= @tab == "url" %>">
      <%= t("admin.companies.tabs.url") %>
    </button>
  </li>
</ul>

<div class="tab-content">
  <div class="tab-pane fade <%= "show active" unless @tab == "url" %>" id="company-manual" role="tabpanel"
       aria-labelledby="company-manual-tab">
    <%= render "admin/companies/form", company: @company %>
  </div>
  <div class="tab-pane fade <%= "show active" if @tab == "url" %>" id="company-url" role="tabpanel"
       aria-labelledby="company-url-tab">
    <%= render "admin/companies/url_form", lookup: @lookup %>
  </div>
</div>
