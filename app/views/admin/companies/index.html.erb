<% content_for :title, t("admin.companies.title") %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="admin-h1 mb-0"><%= t("admin.companies.title") %></h1>
  <%= link_to t("admin.companies.new"), new_admin_company_path, class: "btn-ink" %>
</div>

<p class="admin-lead"><%= t("admin.companies.lead") %></p>

<form method="get" class="mb-4">
  <input type="search" name="q" value="<%= @q %>" class="form-control"
         placeholder="<%= t("jobseeker.companies.search_placeholder") %>">
</form>

<div class="table-responsive admin-table-wrap">
  <table class="table table-hover align-middle mb-0">
    <thead>
      <tr>
        <th><%= t("jobseeker.companies.official_name") %></th>
        <th><%= t("jobseeker.companies.kind") %></th>
        <th><%= t("jobseeker.companies.country") %></th>
        <th><%= t("jobseeker.companies.legal_id") %></th>
        <th class="text-end"><%= t("admin.users.actions") %></th>
      </tr>
    </thead>
    <tbody>
      <% @companies.each do |company| %>
        <tr>
          <td>
            <strong><%= company.display_name %></strong>
            <div class="text-secondary small"><%= company.official_name %></div>
          </td>
          <td><%= t("jobseeker.companies.kinds.#{company.kind}") %></td>
          <td><%= company.country.presence || "—" %></td>
          <td>
            <% if company.legal_id.present? %>
              <%= t("jobseeker.companies.legal_id_kinds.#{company.legal_id_kind}") %> <%= company.legal_id %>
            <% else %>
              —
            <% end %>
          </td>
          <td class="text-end">
            <div class="d-inline-flex gap-2 justify-content-end">
              <%= link_to t("admin.users.edit"), edit_admin_company_path(company), class: "btn btn-sm btn-outline-secondary" %>
              <%= button_to t("admin.users.delete"), admin_company_path(company), method: :delete,
                    class: "btn btn-sm btn-outline-danger",
                    form: { data: { turbo_confirm: t("admin.companies.confirm_delete") } } %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
