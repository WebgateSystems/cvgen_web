<div class="dropdown user-menu">
  <button class="user-menu-toggle dropdown-toggle" type="button" data-bs-toggle="dropdown"
          aria-expanded="false" aria-label="<%= t("nav.account_menu") %>">
    <%= user_avatar_tag(current_user, size: :sm) %>
  </button>
  <ul class="dropdown-menu dropdown-menu-end user-menu__dropdown">
    <li>
      <div class="user-menu__identity">
        <%= user_avatar_tag(current_user, size: :md) %>
        <div>
          <strong><%= current_user.display_name %></strong>
          <span><%= current_user.email %></span>
        </div>
      </div>
    </li>
    <li><hr class="dropdown-divider"></li>
    <% if current_user.can_use_jobseeker_studio? %>
      <li>
        <%= link_to jobseeker_account_path, class: "dropdown-item" do %>
          <i class="bi bi-person" aria-hidden="true"></i>
          <%= t("nav.account") %>
        <% end %>
      </li>
    <% end %>
    <% if local_assigns[:landing] %>
      <% if current_user.admin? %>
        <li>
          <%= link_to admin_root_path, class: "dropdown-item" do %>
            <i class="bi bi-shield-lock" aria-hidden="true"></i>
            <%= t("nav.admin") %>
          <% end %>
        </li>
      <% end %>
      <% if current_user.can_use_jobseeker_studio? %>
        <li>
          <%= link_to jobseeker_root_path, class: "dropdown-item" do %>
            <i class="bi bi-layout-sidebar" aria-hidden="true"></i>
            <%= t("nav.studio") %>
          <% end %>
        </li>
      <% end %>
    <% end %>
    <li>
      <%= button_to destroy_user_session_path, method: :delete, class: "dropdown-item user-menu__sign-out",
            form: { class: "user-menu__sign-out-form" } do %>
        <i class="bi bi-box-arrow-left" aria-hidden="true"></i>
        <%= t("nav.sign_out") %>
      <% end %>
    </li>
  </ul>
</div>
