<%# locals: f, prefix: "companies" %>
<% f.object.identifiers.build(kind: "nip") if f.object.identifiers.reject(&:marked_for_destruction?).empty? %>
<div class="row g-3">
  <div class="col-md-4">
    <%= f.label :shortcut, t("jobseeker.companies.shortcut"), class: "form-label" %>
    <%= f.text_field :shortcut, class: "form-control", placeholder: "YND" %>
  </div>
  <div class="col-md-8">
    <%= f.label :official_name, t("jobseeker.companies.official_name"), class: "form-label" %>
    <%= f.text_field :official_name, class: "form-control", required: local_assigns[:required] %>
  </div>
  <div class="col-md-4">
    <%= f.label :kind, t("jobseeker.companies.kind"), class: "form-label" %>
    <%= f.select :kind,
          Company::KINDS.map { |kind| [ t("jobseeker.companies.kinds.#{kind}"), kind ] },
          {},
          class: "form-select" %>
  </div>
</div>

<fieldset class="company-fieldset mt-4" data-controller="company-identifiers">
  <legend class="form-label"><%= t("jobseeker.companies.identifiers") %></legend>
  <p class="form-text mt-0"><%= t("jobseeker.companies.identifiers_hint") %></p>
  <div class="d-grid gap-3" data-company-identifiers-target="list">
    <%= f.fields_for :identifiers do |identifier_form| %>
      <%= render "shared/company_identifier_fields", f: identifier_form %>
    <% end %>
  </div>
  <template data-company-identifiers-target="template">
    <%= f.fields_for :identifiers, CompanyIdentifier.new, child_index: "NEW_RECORD" do |identifier_form| %>
      <%= render "shared/company_identifier_fields", f: identifier_form %>
    <% end %>
  </template>
  <button type="button" class="btn-ghost mt-3" data-action="company-identifiers#add">
    <%= t("jobseeker.companies.identifier_add") %>
  </button>
</fieldset>

<fieldset class="company-fieldset mt-4">
  <legend class="form-label"><%= t("jobseeker.companies.address") %></legend>
  <div class="row g-3">
    <div class="col-md-4">
      <%= f.label :country, t("jobseeker.companies.country"), class: "form-label" %>
      <%= f.select :country,
            Company::COUNTRIES.map { |code| [ code, code ] },
            { include_blank: t("jobseeker.applications.blank") },
            class: "form-select" %>
    </div>
    <div class="col-md-8">
      <%= f.label :street, t("jobseeker.companies.street"), class: "form-label" %>
      <%= f.text_field :street, class: "form-control" %>
    </div>
    <div class="col-md-4">
      <%= f.label :city, t("jobseeker.companies.city"), class: "form-label" %>
      <%= f.text_field :city, class: "form-control" %>
    </div>
    <div class="col-md-4">
      <%= f.label :postal_code, t("jobseeker.companies.postal_code"), class: "form-label" %>
      <%= f.text_field :postal_code, class: "form-control" %>
    </div>
  </div>
</fieldset>
