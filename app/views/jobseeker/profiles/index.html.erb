<% content_for :title, t("jobseeker.profiles.title") %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="admin-h1 mb-0"><%= t("jobseeker.profiles.title") %></h1>
  <%= link_to t("jobseeker.profiles.new"), new_jobseeker_profile_path, class: "btn-ink" %>
</div>

<p class="admin-lead"><%= t("jobseeker.profiles.lead") %></p>

<% if @profiles.any? %>
  <div class="table-responsive admin-table-wrap">
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <th><%= t("jobseeker.profiles.name") %></th>
          <th><%= t("jobseeker.profiles.latest") %></th>
          <th><%= t("jobseeker.profiles.person") %></th>
          <th class="text-end"><%= t("admin.users.actions") %></th>
        </tr>
      </thead>
      <tbody>
        <% @profiles.each do |profile| %>
          <% latest = profile.latest_version %>
          <tr>
            <td>
              <strong><%= link_to profile.name, jobseeker_profile_path(profile), class: "link-quiet" %></strong>
              <div class="text-secondary small"><%= t("jobseeker.profiles.version_count", count: profile.versions.size) %></div>
            </td>
            <td>
              <% if latest %>
                <%= latest.label %>
              <% else %>
                —
              <% end %>
            </td>
            <td><%= profile.person_name || "—" %></td>
            <td class="text-end">
              <div class="d-inline-flex gap-2 justify-content-end">
                <%= link_to t("jobseeker.versions.add"), new_jobseeker_profile_version_path(profile), class: "btn btn-sm btn-outline-secondary" %>
                <%= link_to t("admin.users.edit"), edit_jobseeker_profile_path(profile), class: "btn btn-sm btn-outline-secondary" %>
                <%= button_to t("admin.users.delete"), jobseeker_profile_path(profile), method: :delete,
                      class: "btn btn-sm btn-outline-danger",
                      form: { data: { turbo_confirm: t("jobseeker.profiles.confirm_delete") } } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="text-secondary"><%= t("jobseeker.profiles.empty") %></p>
<% end %>
