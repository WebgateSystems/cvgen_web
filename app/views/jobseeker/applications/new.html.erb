<% content_for :title, t("jobseeker.applications.new") %>

<h1 class="admin-h1"><%= t("jobseeker.applications.new") %></h1>
<p class="admin-lead"><%= t("jobseeker.applications.form_lead") %></p>

<ul class="nav nav-tabs mb-4" role="tablist">
  <li class="nav-item" role="presentation">
    <button class="nav-link <%= "active" unless @tab == "url" %>" id="application-manual-tab"
            data-bs-toggle="tab" data-bs-target="#application-manual" type="button" role="tab"
            aria-controls="application-manual" aria-selected="<%= @tab != "url" %>">
      <%= t("jobseeker.applications.tabs.manual") %>
    </button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link <%= "active" if @tab == "url" %>" id="application-url-tab"
            data-bs-toggle="tab" data-bs-target="#application-url" type="button" role="tab"
            aria-controls="application-url" aria-selected="<%= @tab == "url" %>">
      <%= t("jobseeker.applications.tabs.url") %>
    </button>
  </li>
</ul>

<div class="tab-content">
  <div class="tab-pane fade <%= "show active" unless @tab == "url" %>" id="application-manual" role="tabpanel"
       aria-labelledby="application-manual-tab">
    <%= render "jobseeker/applications/form", application: @application %>
  </div>
  <div class="tab-pane fade <%= "show active" if @tab == "url" %>" id="application-url" role="tabpanel"
       aria-labelledby="application-url-tab">
    <%= render "jobseeker/applications/url_form", lookup: @lookup %>
  </div>
</div>
