<%= turbo_frame_tag "application_modal" do %>
  <div class="cv-modal" data-controller="cv-modal" data-action="keydown@window->cv-modal#keydown" role="presentation">
    <button type="button" class="cv-modal__backdrop" tabindex="-1" data-action="cv-modal#close" aria-label="<%= t("jobseeker.applications.close") %>"></button>
    <div class="cv-modal__panel" role="dialog" aria-modal="true" aria-labelledby="application-modal-title" tabindex="-1">
      <div class="cv-modal__header">
        <h2 class="cv-modal__title" id="application-modal-title"><%= application.position %></h2>
        <button type="button" class="admin-icon-btn btn btn-outline-secondary" data-action="cv-modal#close" aria-label="<%= t("jobseeker.applications.close") %>">
          <i class="bi bi-x-lg" aria-hidden="true"></i>
        </button>
      </div>
      <div class="cv-modal__body">
        <p class="admin-lead mb-4">
          <% if application.company %>
            <%= link_to application.company.display_name, jobseeker_company_path(application.company),
                  data: { turbo_frame: "_top" } %>
            <span class="badge text-bg-secondary ms-2"><%= t("jobseeker.companies.kinds.#{application.company.kind}") %></span>
          <% end %>
        </p>
        <dl class="application-dl">
          <% JobApplication::INDEX_COLUMNS.each do |column| %>
            <div class="application-dl__row">
              <dt><%= t("jobseeker.applications.#{column}") %></dt>
              <dd><%= application_field_value(application, column) %></dd>
            </div>
          <% end %>
        </dl>

        <h3 class="h6 mt-4"><%= t("jobseeker.applications.timeline") %></h3>
        <ol class="application-timeline">
          <% application.application_events.chronological.each do |event| %>
            <li class="application-timeline__item">
              <span class="application-timeline__meta">
                <%= l(event.created_at, format: :short) %>
                · <%= t("jobseeker.applications.event_kinds.#{event.kind}") %>
              </span>
              <% if event.status_change? %>
                <div>
                  <%= [ event.from_status, event.to_status ].compact.map { |status| t("jobseeker.applications.statuses.#{status}") }.join(" → ") %>
                  <% if event.dropout_reason.present? %>
                    <span class="text-secondary">(<%= t("jobseeker.applications.dropout_reasons.#{event.dropout_reason}") %>)</span>
                  <% end %>
                </div>
              <% end %>
              <% if event.body.present? %>
                <p class="mb-0"><%= event.body %></p>
              <% end %>
            </li>
          <% end %>
        </ol>

        <%= form_with model: (local_assigns[:event] || application.application_events.new),
              url: jobseeker_application_events_path(application),
              class: "mt-3" do |f| %>
          <%= f.label :body, t("jobseeker.applications.message"), class: "form-label" %>
          <%= f.text_area :body, class: "form-control", rows: 3, required: true %>
          <div class="mt-2">
            <%= f.submit t("jobseeker.applications.add_message"), class: "btn-ink btn-ink--compact" %>
          </div>
        <% end %>
      </div>
      <div class="cv-modal__footer">
        <%= link_to t("jobseeker.applications.edit"), edit_jobseeker_application_path(application),
              class: "btn-ink", data: { turbo_frame: "_top" } %>
        <button type="button" class="btn-ghost" data-action="cv-modal#close">
          <%= t("jobseeker.applications.close") %>
        </button>
      </div>
    </div>
  </div>
<% end %>
