<% content_for :title, t("jobseeker.companies.title") %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="admin-h1 mb-0"><%= t("jobseeker.companies.title") %></h1>
</div>

<p class="admin-lead"><%= t("jobseeker.companies.lead") %></p>

<form method="get" class="mb-4">
  <label class="visually-hidden" for="company-search"><%= t("jobseeker.companies.search") %></label>
  <input id="company-search" type="search" name="q" value="<%= @q %>"
         class="form-control" placeholder="<%= t("jobseeker.companies.search_placeholder") %>">
</form>

<% if @companies.empty? %>
  <p class="text-secondary"><%= t("jobseeker.companies.empty") %></p>
<% else %>
  <div class="table-responsive admin-table-wrap">
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <th><%= t("jobseeker.companies.official_name") %></th>
          <th><%= t("jobseeker.companies.kind") %></th>
          <th><%= t("jobseeker.companies.country") %></th>
          <th><%= t("jobseeker.companies.rating") %></th>
        </tr>
      </thead>
      <tbody>
        <% @companies.each do |company| %>
          <tr>
            <td>
              <%= link_to company.display_name, jobseeker_company_path(company) %>
              <% if company.official_name != company.display_name %>
                <div class="text-secondary small"><%= company.official_name %></div>
              <% end %>
            </td>
            <td><%= t("jobseeker.companies.kinds.#{company.kind}") %></td>
            <td><%= company.country.presence || "—" %></td>
            <td><%= company.formatted_rating || "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
