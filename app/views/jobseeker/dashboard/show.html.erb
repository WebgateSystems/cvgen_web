<% content_for :title, t("jobseeker.dashboard") %>

<h1 class="admin-h1"><%= t("jobseeker.dashboard") %></h1>
<p class="admin-lead"><%= t("jobseeker.dashboard_lead") %></p>

<div class="row g-3 mb-4">
  <div class="col-md-4">
    <div class="admin-stat">
      <span><%= t("jobseeker.profiles.title") %></span>
      <strong><%= @profiles.size %></strong>
    </div>
  </div>
  <div class="col-md-4">
    <div class="admin-stat">
      <span><%= t("jobseeker.themes.personal") %></span>
      <strong><%= @personal_themes.size %></strong>
    </div>
  </div>
  <div class="col-md-4">
    <div class="admin-stat">
      <span><%= t("jobseeker.themes.system") %></span>
      <strong><%= @system_themes_count %></strong>
    </div>
  </div>
</div>

<div class="d-flex flex-wrap gap-2">
  <%= link_to t("jobseeker.cvs.title"), jobseeker_cv_path, class: "btn-ink" %>
  <%= link_to t("jobseeker.profiles.new"), new_jobseeker_profile_path, class: "btn-ghost" %>
  <%= link_to t("jobseeker.themes.upload"), new_jobseeker_theme_path, class: "btn-ghost" %>
</div>
