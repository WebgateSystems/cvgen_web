<% content_for :title, t("brand") %>
<% content_for :body_class, "landing-body" %>

<div class="landing">
  <header class="landing-nav">
    <a class="brand" href="<%= root_path %>"><%= t("brand") %></a>

    <div class="landing-nav__controls">
      <div class="dropdown">
        <button class="ctrl-btn dropdown-toggle" type="button" data-bs-toggle="dropdown"
                aria-expanded="false" aria-label="<%= t("nav.language") %>">
          <i class="bi bi-translate" aria-hidden="true"></i>
          <span><%= I18n.locale.to_s.upcase %></span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
          <li><%= link_to "English", locale_path(locale: :en), class: "dropdown-item #{'active' if I18n.locale == :en}" %></li>
          <li><%= link_to "Polski", locale_path(locale: :pl), class: "dropdown-item #{'active' if I18n.locale == :pl}" %></li>
        </ul>
      </div>

      <div class="dropdown">
        <button class="ctrl-btn dropdown-toggle" type="button" data-bs-toggle="dropdown"
                aria-expanded="false" aria-label="<%= t("nav.theme") %>">
          <i class="bi bi-circle-half" aria-hidden="true"></i>
          <span data-theme-target="label"><%= t("nav.theme_system") %></span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
          <li><button type="button" class="dropdown-item" data-action="theme#system"><%= t("nav.theme_system") %></button></li>
          <li><button type="button" class="dropdown-item" data-action="theme#light"><%= t("nav.theme_light") %></button></li>
          <li><button type="button" class="dropdown-item" data-action="theme#dark"><%= t("nav.theme_dark") %></button></li>
        </ul>
      </div>

      <div class="landing-nav__auth">
        <% if user_signed_in? %>
          <%= render "shared/account_menu", landing: true %>
        <% else %>
          <%= link_to t("nav.sign_in"), new_user_session_path, class: "link-quiet" %>
          <%= link_to t("nav.sign_up"), new_user_registration_path, class: "btn-ink" %>
        <% end %>
      </div>
    </div>
  </header>

  <main class="landing-hero">
    <div class="landing-hero__copy">
      <p class="brand-mark"><%= t("brand") %></p>
      <p class="eyebrow"><%= t("landing.eyebrow") %></p>
      <h1><%= t("landing.headline") %></h1>
      <p class="lead"><%= t("landing.lead") %></p>

      <div class="cta-row">
        <% if user_signed_in? %>
          <% if current_user.admin? %>
            <%= link_to t("landing.cta_admin"), admin_root_path, class: "btn-ink btn-ink--lg" %>
            <%= link_to t("landing.cta_studio"), jobseeker_root_path, class: "btn-ghost btn-ghost--lg" %>
          <% elsif current_user.can_use_jobseeker_studio? %>
            <%= link_to t("landing.cta_signed_in"), jobseeker_root_path, class: "btn-ink btn-ink--lg" %>
          <% end %>
        <% else %>
          <%= link_to t("landing.cta_primary"), new_user_registration_path, class: "btn-ink btn-ink--lg" %>
          <%= link_to t("landing.cta_secondary"), new_user_session_path, class: "btn-ghost btn-ghost--lg" %>
        <% end %>
      </div>

      <% unless user_signed_in? %>
        <%= render "shared/oauth_buttons", wrapper_class: nil, hint: true %>
      <% end %>
    </div>

    <div class="landing-hero__stage" aria-hidden="true">
      <div class="doc-plane">
        <div class="doc-plane__glow"></div>
        <article class="doc-sheet">
          <header class="doc-sheet__head">
            <span class="doc-sheet__label"><%= t("landing.visual_label") %></span>
            <strong>Alex Rivera</strong>
            <em><%= t("landing.visual_role") %></em>
          </header>
          <div class="doc-sheet__rule"></div>
          <ul class="doc-sheet__lines">
            <li></li><li></li><li></li><li class="short"></li>
          </ul>
          <div class="doc-sheet__offer">
            <span><%= t("landing.visual_company") %></span>
            <span class="pill">PDF</span>
          </div>
        </article>
        <article class="doc-sheet doc-sheet--letter">
          <header class="doc-sheet__head">
            <span class="doc-sheet__label">Cover letter</span>
            <strong><%= t("landing.visual_company") %></strong>
          </header>
          <div class="doc-sheet__rule"></div>
          <ul class="doc-sheet__lines">
            <li></li><li></li><li class="short"></li><li></li><li class="short"></li>
          </ul>
        </article>
      </div>
    </div>
  </main>

  <footer class="landing-footer">
    <%= render "shared/app_version" %>
  </footer>
</div>
